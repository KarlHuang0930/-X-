function checkElementRelation(elemA, elemB) {
    if (elemA === elemB) {
        return { type: "比和", label: "比和 (同質和合)", css: "rel-bihe", desc: "五行同質，能量聚集" };
    }
    const generates = { "木": "火", "火": "土", "土": "金", "金": "水", "水": "木" };
    const overcomes = { "木": "土", "土": "水", "水": "火", "火": "金", "金": "木" };

    if (generates[elemA] === elemB) {
        return { type: "神生宮", label: "生宮 (洩氣於宮)", css: "rel-sheng", desc: "五行相生，主動賦能" };
    }
    if (generates[elemB] === elemA) {
        return { type: "宮生神", label: "受生 (受宮資養)", css: "rel-sheng", desc: "受環境資養賦能" };
    }
    if (overcomes[elemA] === elemB) {
        return { type: "神剋宮", label: "剋宮 (主動壓制)", css: "rel-ke", desc: "主動施加控制或壓制" };
    }
    if (overcomes[elemB] === elemA) {
        return { type: "宮剋神", label: "受剋 (受宮壓制)", css: "rel-ke", desc: "受客觀環境壓制阻礙" };
    }
    return { type: "平和", label: "平和", css: "rel-bihe", desc: "氣場平順" };
}

function runAnalysis() {
    const question = document.getElementById('userQuestion').value.trim() || "未指定提問內容";
    const dun = document.getElementById('dunType').value;
    const domainKey = document.getElementById('domain').value;

    let n1 = 1, n2 = 1, n3 = 1;
    let inputSummaryText = "";

    if (currentMode === 'datetime') {
        const calType = document.getElementById('calendarType').value;
        const m = parseInt(document.getElementById('monthSelect').value);
        const d = parseInt(document.getElementById('daySelect').value);
        const h = parseInt(document.getElementById('hourSelect').value);
        
        n1 = m; n2 = d; n3 = h;
        inputSummaryText = `時間起卦 (${calType === 'lunar' ? '農曆' : '國曆'})：${m}月 / ${d}日 / 時辰碼${h}`;
    } else {
        n1 = parseInt(document.getElementById('num1').value);
        n2 = parseInt(document.getElementById('num2').value);
        n3 = parseInt(document.getElementById('num3').value);
        inputSummaryText = `三數字起卦：[${n1}], [${n2}], [${n3}]`;
    }

    let pos_m = ((n1 - 1) % 9) + 1;
    let pos_d = ((pos_m - 1 + (n2 - 1)) % 9) + 1;
    let pos_h = ((pos_d - 1 + (n3 - 1)) % 9) + 1;

    const monthSpirit = NINE_SPIRITS[pos_m - 1];
    const daySpirit   = NINE_SPIRITS[pos_d - 1];
    const hourSpirit  = NINE_SPIRITS[pos_h - 1];

    let spiritHomePalace = hourSpirit.loShuPalace;
    let anchorPalace = spiritHomePalace;
    let isJiGong = false;
    let jiGongReason = "";

    if (spiritHomePalace === 5) {
        isJiGong = true;
        if (dun === 'yang') {
            anchorPalace = 8;
            jiGongReason = `5中宮空亡（不入用神） + 陽遁 ➔ 正統借位：借【艮8宮】起飛布神`;
        } else {
            anchorPalace = 2;
            jiGongReason = `5中宮空亡（不入用神） + 陰遁 ➔ 正統借位：借【坤2宮】起飛布神`;
        }
    }

    const ringPath = (dun === 'yang') ? OUTER_RING_YANG : OUTER_RING_YIN;
    const anchorIndex = ringPath.indexOf(anchorPalace);
    
    let palaceMap = {};
    for (let i = 0; i < 8; i++) {
        let p = ringPath[(anchorIndex + i) % 8];
        palaceMap[p] = EIGHT_SPIRITS[i];
    }

    renderBoard(anchorPalace, palaceMap);
    renderReportAndTriggerAI(question, inputSummaryText, monthSpirit, daySpirit, hourSpirit, anchorPalace, palaceMap, dun, domainKey, isJiGong, jiGongReason);
}

function renderBoard(anchor, map) {
    const boardOrder = [4, 9, 2, 3, 5, 7, 8, 1, 6];
    const boardEl = document.getElementById('palaceBoard');
    boardEl.innerHTML = '';

    boardOrder.forEach(p => {
        const cell = document.createElement('div');
        cell.className = `palace-cell ${p === anchor ? 'active-anchor' : ''}`;
        
        if (p === 5) {
            cell.innerHTML = `
                <div class="palace-header"><span>5宮</span><span>中土</span></div>
                <div class="spirit-title" style="color:var(--accent-red);">空亡(寄位)</div>
                <div style="font-size:0.7rem; color:var(--text-sub);">[中宮不入用神]</div>
            `;
        } else {
            const sp = map[p];
            const palaceObj = PALACES[p];
            const spNine = NINE_SPIRITS.find(s => s.loShuPalace === p) || { element: "土" };
            const rel = checkElementRelation(spNine.element, palaceObj.element);

            cell.innerHTML = `
                <div class="palace-header">
                    <span>${p} ${palaceObj.short}</span>
                    <span class="relation-tag ${rel.css}">${rel.type}</span>
                </div>
                <div class="spirit-title">${sp ? sp.name : ''}</div>
                <div style="font-size:0.75rem; color:var(--accent-blue);">${DOMAIN_MAPS.business[p].substring(0,6)}</div>
                ${sp && sp.sub ? `<div class="sub-spirit">${sp.sub}</div>` : '<div style="height:12px;"></div>'}
            `;
        }
        boardEl.appendChild(cell);
    });
}

